{
  "name": "monstera",
  "version": "0.0.0",
  "private": true,
  "description": "Monstera PDF Editor — a free, open-source, professional-grade PDF editor for Windows.",
  "license": "AGPL-3.0-or-later",
  "author": "Tenslor Inc.",
  "homepage": "https://monsterapdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenslorai-tar/monstera.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/bootstrapHooks.mjs",
    "typecheck": "tsc --build --pretty && tsc -p tsconfig.scripts.json --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "provision:gitleaks": "node scripts/provision/gitleaks.mjs",
    "provision:mupdf": "node scripts/provision/mupdf.mjs",
    "proof:shim": "node scripts/provision/mupdf.proof.mjs",
    "guard:staged": "node scripts/hooks/guardFiles.mjs --staged",
    "guard:tree": "node scripts/hooks/guardFiles.mjs --tree",
    "scan:secrets": "node scripts/hooks/scanSecrets.mjs",
    "proof:guards": "node scripts/hooks/guardFiles.proof.mjs && node scripts/hooks/preCommit.proof.mjs && node scripts/bootstrapHooks.proof.mjs",
    "proof:secretscan": "node scripts/lib/secretScan.proof.mjs",
    "proof:verdict": "node scripts/lib/verdict.proof.mjs",
    "proof:shimstate": "node scripts/lib/shimBinary.proof.mjs",
    "proof:withdrawn": "node scripts/lib/withdrawnPhrases.proof.mjs",
    "proof:escapeguard": "node scripts/hooks/blockEscapeResolvingWrites.proof.mjs",
    "proof:hookintegrity": "node scripts/lib/hookIntegrity.proof.mjs",
    "proof:hookprobe": "node scripts/proofs/hookProbe.proof.mjs",
    "proof:docscope": "node scripts/proofs/documentScope.proof.mjs",
    "proof:budgets": "node scripts/proofs/memoryBudgets.proof.mjs",
    "proof:peakrss": "node scripts/proofs/peakRss.proof.mjs",
    "proof:nativeaddon": "node scripts/proofs/nativeAddon.proof.mjs",
    "proof:perfbudget": "node scripts/proofs/perfBudget.proof.mjs",
    "perf:gate": "node scripts/perf/budgetGate.mjs",
    "probe:hook": "node scripts/hooks/recordHookProbe.mjs",
    "proof:canary": "node scripts/lib/scannerCanary.proof.mjs",
    "proof:provision": "node scripts/provision/gitleaks.proof.mjs",
    "proof:boundaries": "node scripts/proofs/boundaries.proof.mjs",
    "proof:testresolution": "node scripts/proofs/testResolution.proof.mjs",
    "proof:lintignores": "node scripts/proofs/lintIgnores.proof.mjs",
    "brand:generate": "node scripts/brand/generateAssets.mjs",
    "brand:check": "node scripts/brand/generateAssets.mjs --check",
    "proof:contract": "node scripts/proofs/contract.proof.mjs",
    "check:lockfile": "node scripts/hooks/lockfileIntegrity.mjs",
    "check:docs": "node scripts/hooks/documentConsistency.mjs",
    "check:advisories": "node scripts/security/engineAdvisories.mjs",
    "notice:generate": "node scripts/release/generateNotice.mjs",
    "notice:check": "node scripts/release/generateNotice.mjs --check",
    "proof:licences": "node scripts/proofs/licenceProvenance.proof.mjs",
    "proof:ocrdoors": "node scripts/proofs/ocrDoors.proof.mjs",
    "ocr:doors": "node scripts/security/ocrDoors.mjs",
    "proof:cff": "node scripts/security/cffOobProof.mjs",
    "proof:geometry": "node scripts/proofs/pageGeometry.proof.mjs",
    "proof:purge": "node scripts/proofs/purgeCensus.proof.mjs",
    "proof:lintrules": "node scripts/proofs/lintRules.proof.mjs",
    "proof:engines": "node scripts/spike/engineSpike.mjs"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.8.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "koffi": "3.1.5",
    "mupdf": "^1.28.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}

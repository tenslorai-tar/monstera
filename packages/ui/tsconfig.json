{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*"
  ],
  // See packages/shared/tsconfig.json and scripts/lib/probeLeftovers.mjs.
  "exclude": [
    "src/**/__boundary_probe__.ts"
  ],
  "references": [
    {
      "path": "../shared"
    },
    {
      "path": "../contract"
    }
  ]
}

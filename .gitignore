# This file is also ESLint's ignore list. `eslint.config.js` derives it here via
# @eslint/compat's includeIgnoreFile, so an artifact path added below stops being
# linted with no second edit. That matters more than tidiness: `projectService`
# makes any .js or .ts outside every tsconfig a FATAL PARSE ERROR, so a build
# directory nobody ignored does not warn — it fails `eslint .` outright.
# `npm run proof:lintignores` holds the two in step, with a control that plants a
# violation in real source so "ignore everything" cannot pass.
#
# Tracked files that are deliberately not linted stay in eslint.config.js. They
# are a different category — source git keeps, that is not code — not a second
# copy of this list.

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
.pnp.*

# ─── Build output ────────────────────────────────────────────────────────────
# `dist/` stays unanchored on purpose: every package builds into its own, so it
# genuinely occurs at every depth. The rest are root-level artifacts and are
# anchored, because `out` and `build` are ordinary directory names that source
# could reasonably use — see the note on /release/ above for what that costs.
dist/
/dist-electron/
/out/
/build/
*.tsbuildinfo
/.vite/
vite.config.*.timestamp-*

# Electron packaging output. Vite's watcher must also ignore this directory:
# chokidar holds a directory handle open for ReadDirectoryChangesW, and an open
# handle blocks RENAME, so electron-builder's rename step fails with EPERM.
#
# Anchored with a leading slash. Unanchored, `release/` matches a directory of
# that name at ANY depth, and it silently swallowed scripts/release/ — the
# NOTICE generator was untracked, unlinted and invisible to the file guard, all
# at once and with no error anywhere. Every artifact entry below that names a
# conventional directory name carries the same hazard, which is why they are
# anchored too.
/release/

# ─── Provisioned binaries — never in git (Part J) ────────────────────────────
# Everything here is downloaded by scripts/provision/* against a pinned
# SHA-256. Git history is permanent the moment the repository is public, so a
# binary committed once is a binary shipped forever.
.tools/
native/
# …except our own shim SOURCE, which is code we wrote and the seam ADR-0010
# mandates. `native/` was written when everything under it was a downloaded
# binary; that is no longer true. Build output stays ignored below.
!native/
!native/**/
native/**/out/
native/**/obj/
*.c.obj

# Belt-and-braces: the pre-commit guard is the real enforcement (it inspects
# staged blob content, which .gitignore cannot), but ignoring these keeps a
# stray build artefact out of `git status` in the first place.
*.exe
*.dll
*.so
*.dylib
*.node
*.msi
*.msix
*.appx
*.wasm
*.pdb
*.lib
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# ─── Secrets and signing material ────────────────────────────────────────────
# Invariant L12: secrets live in the OS keychain or in untracked local files,
# never in the repository, never echoed in CI logs.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
secrets.json
*.local.json

# ─── Test artefacts ──────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Fixtures too large for the pre-commit size guard are generated
# deterministically at test time (Part I, fixture size rule) rather than
# committed — above all the 200 MB document the performance assertion needs.
packages/testing/fixtures/generated/

# ─── Logs and runtime state ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# ─── Editor and OS ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
.vs/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ─── Tool caches ─────────────────────────────────────────────────────────────
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
*.tgz
install.log
.probe/

# Proof scratch that must live INSIDE a package to be linted at all — a boundary
# rule scoped to `packages/ui/**` cannot see a file in `.probe/`. The proof
# passes `--no-ignore` so it still inspects them; ignoring them here means a
# proof killed before its cleanup cannot reach a commit or redden a later lint.
__boundary_probe__.ts

# Same reason, for the plain-Node rule: a probe proving `scripts/` may not import
# Electron has to live UNDER `scripts/` to match the config block that restricts
# it. Ignored here so a proof killed mid-run cannot redden a later lint or reach
# a commit; the proof lints it with `ignore: false` so it still sees the file.
__import_probe__.mjs
__import_probe__.js

# ─── Agent settings ──────────────────────────────────────────────────────────
# `.claude/settings.json` IS tracked: it registers the PreToolUse guard that
# makes escape-resolving file writes unavailable, and a guard that lives on one
# machine protects one machine.
#
# The personal override beside it is not tracked, and that is precisely why
# scripts/lib/hookIntegrity.mjs inspects it: a settings file at a scope above
# the project's can carry `disableAllHooks` or a competing `hooks` block, and
# neither would ever appear in a diff. Ignoring it here stops a contributor's
# local paths reaching the repository; the pre-commit check is what stops it
# quietly disarming the guards.
.claude/settings.local.json


<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the shim as a DLL, statically linking MuPDF.

  MSBuild rather than a hand-rolled cl.exe invocation: setting INCLUDE and LIB by
  hand means hard-coding a Windows SDK version, and MSBuild already resolves the
  toolchain from the project.

  Driving MSBuild directly also avoids vcvars64.bat, which fails when invoked
  programmatically. The mechanism recorded here previously — that a bash or
  PowerShell parent cannot represent %ProgramFiles(x86)%, so it arrives unset —
  is wrong, and was corrected after being measured. The variable IS set and
  readable, including from a cmd launched by bash. What actually breaks is cmd's
  own block parser: expanded inside a parenthesised block, %ProgramFiles(x86)%
  is terminated at the ")" inside its own name, so vcvars' vswhere lookup
  collapses and the path degrades to "\Microsoft Visual Studio\...". It fails
  identically with cmd as the parent, so the shell plays no part. See
  scripts/lib/msvc.mjs for the four measurements.

  MupdfRoot is a property, not a fixed sibling directory. MuPDF is a provisioned
  artefact and lives under .tools/ with everything else provisioning downloads;
  the previous default put a 68 MB third-party source tree inside native/, which
  .gitignore does not cover, so following the build recipe left ~15,000 untracked
  files in git status. scripts/provision/mupdf.mjs passes the real path.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7A1C2E44-9B3D-4F58-AE21-6C0D9B4E1F30}</ProjectGuid>
    <RootNamespace>monstera_mupdf</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\out\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\obj\</IntDir>
    <TargetName>monstera_mupdf</TargetName>
    <!-- Overridden by scripts/provision/mupdf.mjs with the provisioned tree.
         The default keeps a manual MSBuild invocation working for someone who
         extracted the source by hand, and is deliberately outside native/. -->
    <MupdfRoot Condition="'$(MupdfRoot)' == ''">$(MSBuildProjectDirectory)\..\..\.tools\mupdf\1.28.0\mupdf-1.28.0-source</MupdfRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Compile as C, not C++: koffi binds a flat ABI and C++ would mangle it. -->
      <CompileAs>CompileAsC</CompileAs>
      <AdditionalIncludeDirectories>$(MupdfRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <WarningLevel>Level3</WarningLevel>

      <!-- Exploit mitigations, stated rather than inherited.
           This library parses hostile input: a PDF is the single largest thing
           an attacker controls in this application, and every byte of it reaches
           MuPDF's C parsers through here. Several of these are on by default,
           and they are written out anyway — a default is a thing that changes
           when a toolchain is upgraded, and nobody notices a mitigation that was
           never named.

           /GS      stack buffer overrun detection (canaries).
           /sdl     additional security checks, and promotes several
                    security-relevant warnings to errors.
           /guard:cf Control Flow Guard: indirect calls are checked against a
                    table of valid targets, which is what turns many corrupted
                    function pointers from exploitable into a crash. -->
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>

      <!-- /DYNAMICBASE + /HIGHENTROPYVA: ASLR with the full 64-bit entropy,
           rather than the 8 bits a 32-bit-compatible layout would give.
           /NXCOMPAT: data pages non-executable.
           /CETCOMPAT: opts in to hardware shadow stacks on CPUs that have them,
           which defeats return-address overwrite outright rather than making it
           harder. It is inert on older CPUs, so there is no floor to raise. -->
      <!-- No /SAFESEH here: it is x86-only and the linker rejects it outright on
           x64 (LNK1246). x64 uses table-based exception handling, where the
           unwind data lives in a read-only section rather than on the stack, so
           the class of attack /SAFESEH exists to stop is not representable. -->
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <HighEntropyVA>true</HighEntropyVA>
      <CETCompat>true</CETCompat>
      <AdditionalLibraryDirectories>$(MupdfRoot)\platform\win32\x64\Release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libmupdf.lib;libthirdparty.lib;libresources.lib;libharfbuzz.lib;libextract.lib;libpkcs7.lib;libleptonica.lib;libtesseract.lib;libzxing.lib;libmubarcode.lib;advapi32.lib;user32.lib;gdi32.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="monstera_mupdf.c" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
